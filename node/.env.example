DATABASE_URL="postgresql://app:app@localhost:5432/vehicle_platform?schema=public"
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

JWT_PRIVATE_KEY_PATH=../secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=../secrets/jwt/public.pem
JWT_ISSUER=project4-node
JWT_AUDIENCE=project4-api
# Use a duration such as 15m, or `never` to issue tokens without an exp claim.
JWT_ACCESS_TOKEN_TTL=15m
JWT_KEY_ID=project4-2026-01

# Browser-visible values use HTTPS through deploy/nginx after certificates are trusted.
PUBLIC_OPERATOR_URL=https://10.174.96.119:39001
VISION_PUBLIC_BASE_URL=https://10.174.96.119:39002
LIVE_VIEW_URL=https://10.174.96.119:39002/
# Node-to-routing is an internal loopback hop.
ROUTING_TRACKING_BASE_URL=http://127.0.0.1:8000
OPERATOR_DEMO_PUBLIC=true
TRUST_PROXY=true

# MinIO playback and relay-to-Node recording registration. Compose enables
# recording in both development and production deployments.
RECORDING_ENABLED=true
# Android GPS persistence from the media relay (POST /internal/telemetry/gps).
# Independent of recording; also requires a real NODE_INTERNAL_SERVICE_TOKEN.
ANDROID_TELEMETRY_ENABLED=false
NODE_INTERNAL_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
MINIO_RECORDING_BUCKET=p4-trip-recordings
MINIO_NODE_ACCESS_KEY=p4-node
MINIO_NODE_SECRET_KEY=replace-node-secret
MINIO_PUBLIC_ENDPOINT=https://10.174.96.119:39003
RECORDING_PLAYBACK_URL_TTL_SECONDS=300
