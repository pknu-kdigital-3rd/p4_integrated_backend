NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_OPERATOR_URL=https://10.174.96.119:39001
VISION_PUBLIC_BASE_URL=https://10.174.96.119:39002
LIVE_VIEW_URL=https://10.174.96.119:39002/
ROUTING_TRACKING_BASE_URL=http://p4-routing:8000
ROUTING_GRAPH_BACKEND=auto
TRUST_PROXY=true
OPERATOR_DEMO_PUBLIC=false

# MinIO recording. Keep the root account for bootstrap only; relay and Node
# use separate bucket-scoped credentials. Use independent random secrets.
# Keep true unless the publisher's submitted trip and vehicle IDs should bypass Node validation.
# false skips trip existence, status, and vehicle match checks; segment metadata still has a trip_id foreign key.
RECORDING_VALIDATE_TRIP_CONTEXT=true
RECORDING_SEGMENT_SECONDS=60
RECORDING_QUEUE_FRAMES=180
RECORDING_UPLOAD_QUEUE=8
RECORDING_SPOOL_DIR=/var/tmp/p4-recordings
RECORDING_SPOOL_MAX_BYTES=10737418240
NODE_INTERNAL_BASE_URL=http://p4-node:3000
# Compose hardcodes JWT and MinIO settings; these entries are retained only for
# direct-process deployments that do not use docker-compose.yml.
NODE_INTERNAL_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
# Store one sample for every N completed inference results: 1 stores all;
# 2 stores results 2, 4, 6, and so on.
RECORDING_DETECTION_SAMPLE_EVERY_N_FRAMES=1
MINIO_ENDPOINT=p4-minio:9000
MINIO_USE_SSL=false
MINIO_RECORDING_BUCKET=p4-trip-recordings
MINIO_ACCESS_KEY=p4-relay
MINIO_SECRET_KEY=replace-relay-secret
MINIO_NODE_ACCESS_KEY=p4-node
MINIO_NODE_SECRET_KEY=replace-node-secret
MINIO_PUBLIC_ENDPOINT=https://10.174.96.119:39003
MINIO_ROOT_USER=p4-minio-root
MINIO_ROOT_PASSWORD=replace-minio-root-password

# Fleet assistant (p4-llm): authenticated MongoDB URL of the KOSHA guide
# parent store; URL-encode special characters in the password. The other
# LLM_* settings default to the shared 10.174.96.119 services.
LLM_PARENT_MONGO_URL=mongodb://USER:PASSWORD@10.174.96.119:37017/?authSource=admin

# Vision internal upstream (TLS terminates at Nginx)
VISION_HOST=0.0.0.0
VISION_PORT=39011
# UniDepth camera matrix in pixels at the calibration image dimensions.
# Example for 20260827_longtrip_merged/intrinsics.json (1280x720):
# UNIDEPTH_CAMERA_INTRINSIC=[[920.0,0.0,640.0],[0.0,690.0,360.0],[0.0,0.0,1.0]]
# UNIDEPTH_CALIBRATION_WIDTH=1280
# UNIDEPTH_CALIBRATION_HEIGHT=720
# Optional depth sampling: mask (default) or inner_box.
# Scale is the fraction of box width/height; 1.0 samples the full box.
# UNIDEPTH_DISTANCE_REGION=inner_box
# UNIDEPTH_DISTANCE_BOX_SCALE=0.5
# Bounds on retained detection polygons and unacknowledged playback data.
# YOLO_MAX_DETECTIONS=32
# YOLO_MASK_MAX_POINTS=256
# PLAYBACK_MAX_FRAMES=300
# BACKLOG_MAX_BYTES=67108864
# Optional gen0 threshold; leave unset to retain Python's default.
# VISION_GC_GEN0_THRESHOLD=10000
TLS_ENABLED=false
FORWARDED_ALLOW_IPS=127.0.0.1
RELAY_KEYFRAME_URL=http://p4-relay:39012/internal/request-keyframe
RELAY_STATUS_URL=http://p4-relay:39012/internal/status

# Go relay internal upstream
RELAY_LISTEN_ADDR=0.0.0.0:39012
PY_ANDROID_LIVE_URL=http://p4-vision:39011/internal/android-live

# Android GPS/IMU telemetry is independent of recording. When true the relay
# validates stream identity through Node, so NODE_INTERNAL_BASE_URL and a real
# NODE_INTERNAL_SERVICE_TOKEN are required. Use the same value for relay and Node.
ANDROID_TELEMETRY_ENABLED=false
PY_TELEMETRY_URL=http://p4-vision:39011/internal/telemetry
MEDIA_RELAY_INTERNAL_BASE_URL=http://p4-relay:39012
# Operator origins allowed to receive presented-frame telemetry via postMessage.
LIVE_VIEW_PARENT_ORIGINS=https://10.174.96.119:39001

# Optional private TURN management (docker-compose.turn-admin.yml + turn-admin profile).
# Independent of demo mode; default is disabled. No public ports are added.
TURN_ADMIN_ENABLED=false
# Set a separate random administration password of at least 24 characters to enable.
# TURN_ADMIN_PASSWORD=

# Server-side inference dataset (host path for Compose, read-only mount).
VISION_SOURCE=server
SERVER_DATASET_DIR=/srv/recordings/my-drive
SERVER_VIDEO_FILE=video.mp4
SERVER_GPS_FILE=gps.csv
SERVER_IMU_FILE=imu.csv
SERVER_SOURCE_START_NS=
SERVER_VEHICLE_ID=server
