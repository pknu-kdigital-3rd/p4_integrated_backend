# Copy to .env.native (ignored by Git). Plain KEY=value or export KEY=value.
# Native overrides Docker addresses, disables Android/recording, and uses
# one public origin for the dashboard and preview.
# PostgreSQL/PostGIS runs inside the SAME existing Jupyter container.
NATIVE_LOCAL_DB=true
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=vehicle_platform
NATIVE_PG_PORT=5432
# Optional: NATIVE_PGDATA=/persistent/path/pgdata
# Optional: NATIVE_POSTGRES_BIN=/path/to/postgresql/bin
# If Jupyter runs as root, PostgreSQL needs an existing non-root OS account:
# NATIVE_PG_RUN_AS=postgres
# For an external database instead, set NATIVE_LOCAL_DB=false and DATABASE_URL.
NATIVE_PUBLIC_URL=https://localhost:39001
NATIVE_GATEWAY_PORT=39001
NATIVE_BIND_HOST=127.0.0.1
NATIVE_TLS=true
NODE_ENV=production

SERVER_DATASET_DIR=/home/kdt/recordings/trip00
SERVER_VIDEO_FILE=pknu_long_trip_video.mp4
SERVER_GPS_FILE=gps_0000.csv
SERVER_IMU_FILE=imu_0000.csv

# Use indices visible INSIDE Jupyter, which may differ from host indices.
YOLO_GPU_INDEX=0
UNIDEPTH_GPU_INDEX=0
YOLO_MODEL=/workspace/services/vision/models/a4_best_640.engine
UNIDEPTH_MODEL_DIR=/workspace/services/vision/models/unidepth-v2-vitb14
YOLO_INFERENCE_SIZE=640x640
UNIDEPTH_INFERENCE_SIZE=720x1280
UNIDEPTH_COMPILE=true
UNIDEPTH_COMPILE_MODE=reduce-overhead
VISION_FRAME_PREP=shared
VISION_FRAME_PREP_THREAD=decode
YOLO_TRT_EXECUTION=async
YOLO_PINNED_INPUT=true
YOLO_MASK_TRANSFER=gpu

# Optional live BIMS key and external assistant endpoint.
# BUSAN_BIMS_SERVICE_KEY=...
# ASSISTANT_BASE_URL=http://reachable-assistant-host:18080
