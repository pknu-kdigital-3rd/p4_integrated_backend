# Copy this file to deploy/env.local, edit the values, then source it from
# every service shell. Do not commit deploy/env.local.
#
#   cp deploy/env.local.example deploy/env.local
#   $EDITOR deploy/env.local
#   set -a; source deploy/env.local; set +a

# Absolute checkout path on the Linux host.
export P4_ROOT="/home/user/p4_integrated_backend"

# Node runtime. The stack script discovers ~/.nvm/nvm.sh when Node is not on
# PATH, then selects or installs this version. Set NVM_DIR only for a custom
# nvm installation location.
export NODE_VERSION="lts/*"
# export NVM_DIR="/custom/path/to/.nvm"

# Common bind address and service ports.
export HOST="127.0.0.1"
export NODE_PORT="3000"
export ROUTING_PORT="8000"
export VISION_PORT="39011"
export RELAY_LISTEN_ADDR="127.0.0.1:39012"
# Relay allocation diagnostics. Leave pprof empty unless profiling locally on a
# trusted host, for example "127.0.0.1:6060".
export RELAY_METRICS_INTERVAL_SECONDS="5"
export RELAY_PPROF_ADDR=""

# PostgreSQL/PostGIS and Node control API.
export DATABASE_URL="postgresql://app:app@127.0.0.1:5432/vehicle_platform?schema=public"
export NODE_ENV="production"
export JWT_PRIVATE_KEY_PATH="${P4_ROOT}/secrets/jwt/private.pem"
export JWT_PUBLIC_KEY_PATH="${P4_ROOT}/secrets/jwt/public.pem"
export JWT_ISSUER="project4-node"
export JWT_AUDIENCE="project4-api"
# Use a duration such as 15m, or "never" to issue tokens without an exp claim.
export JWT_ACCESS_TOKEN_TTL="15m"
export JWT_KEY_ID="project4-2026-01"

# Browser-visible URLs. Change the address together with the certificate SAN.
export TLS_PUBLIC_ADDRESS="10.174.96.95"
export PUBLIC_OPERATOR_URL="https://10.174.96.95:39001"
export VISION_PUBLIC_BASE_URL="https://10.174.96.95:39002"
export LIVE_VIEW_URL="https://10.174.96.95:39002/"
export ROUTING_TRACKING_BASE_URL="http://${HOST}:${ROUTING_PORT}"
export ROUTING_TRACKING_SERVICE_TOKEN=""
# auto prefers osmnx when its optional dependencies are installed and falls
# back to the bundled parser; osmnx installs the full graph backend during
# `scripts/run-linux-stack.sh setup`.
export ROUTING_GRAPH_BACKEND="auto"
export TRUST_PROXY="true"

# Temporary read-only dashboard access. Set false before exposing beyond a
# trusted development LAN; normal JWT/RBAC routes remain enabled.
export OPERATOR_DEMO_PUBLIC="true"

# Route/tracking. Playback is deterministic and needs no BIMS key. Change to
# live and provide BUSAN_BIMS_SERVICE_KEY when live BIMS polling is desired.
export TELEMETRY_MODE="playback"
export BUSAN_BUS_HISTORY_PATH="${P4_ROOT}/services/routing-tracking/data/busan_bus_gps.csv"
export BUSAN_BUS_HYBRID_PATH="${P4_ROOT}/services/routing-tracking/data/busan_bus_hybrid.csv"
# export TELEMETRY_MODE="live"
# export BUSAN_BIMS_SERVICE_KEY="replace-with-data-go-kr-key"

# Vision Python/WebRTC/YOLO service. The RTX 3090 should use CUDA 0.
export YOLO_DEVICE="cuda:0"
export YOLO_HALF="true"
# Set to the deployment TensorRT engine when it is installed, for example:
# export YOLO_MODEL="/home/user/models/vehicle-seg.engine"
# Relative model paths resolve from services/vision.
export YOLO_MODEL="models/yolo26s-seg.pt"
# Detail-first masks. Set false when latency matters more than polygon detail.
export YOLO_RETINA_MASKS="true"
# Bound worst-case NMS and segmentation work on crowded frames.
export YOLO_MAX_DETECTIONS="100"
# Resize masks on-device before CPU contour extraction. Lower to 320 or 160 if
# latency matters more than polygon detail.
export YOLO_MASK_CONTOUR_SIZE="640"
# Optional OpenCV contour simplification. Keep false when polygon fidelity is
# more important than JSON/browser payload size.
export YOLO_MASK_POLYGON_SIMPLIFY="false"
export YOLO_MASK_POLYGON_EPSILON_RATIO="0.002"
# Inference queue policy: "latest" keeps the newest decoded frame for model
# work while preserving every compressed media frame for browser decoding.
# "queue" is finite and useful for ordered debugging only.
export YOLO_FRAME_DROP_POLICY="latest"
export YOLO_INFERENCE_QUEUE_SIZE="1"
export METRICS_LOG_INTERVAL_SECONDS="5"
export ENABLE_PYTHON_ALLOC_PROFILE="false"
export TLS_ENABLED="false"
export FORWARDED_ALLOW_IPS="127.0.0.1"
export YOLO_FEED_SOCKET="/tmp/poc-relay-yolo.sock"
export RELAY_KEYFRAME_URL="http://${HOST}:39012/internal/request-keyframe"
export RELAY_STATUS_URL="http://${HOST}:39012/internal/status"

# Go relay and TURN. Use a strong TURN password in the real file. Set
# TURN_URL empty to disable TURN for a same-LAN smoke test.
export TURN_URL="turn:10.174.96.95:3478?transport=udp"
export TURN_USERNAME="user"
export TURN_PASSWORD="replace-with-strong-turn-password"
export PY_ANDROID_LIVE_URL="http://${HOST}:${VISION_PORT}/internal/android-live"

# Optional compressed-video recording to a private MinIO bucket. Generate
# distinct passwords for relay, Node, and MinIO root before enabling it.
export RECORDING_ENABLED="false"
# When true, recording requires an existing IN_PROGRESS trip assigned to this vehicle.
# Set false to skip Node's trip existence, status, and vehicle match checks.
# Database recording rows still require an existing trip because of the trip_id foreign key.
export RECORDING_VALIDATE_TRIP_CONTEXT="true"
export RECORDING_SEGMENT_SECONDS="60"
export RECORDING_QUEUE_FRAMES="180"
export RECORDING_UPLOAD_QUEUE="8"
export RECORDING_SPOOL_DIR="/var/tmp/p4-recordings"
export RECORDING_SPOOL_MAX_BYTES="10737418240"
export NODE_INTERNAL_BASE_URL="http://${HOST}:${NODE_PORT}"
export NODE_INTERNAL_SERVICE_TOKEN="replace-with-a-random-token-at-least-32-characters"
# Vision stores new replay detection samples through Node using the same
# internal URL and token. Its bounded queue defaults to 256 samples.
export RECORDING_DETECTION_QUEUE_SIZE="256"
# Store one replay sample for every N completed inference results: 1 stores all,
# 2 stores results 2, 4, 6, and so on.
export RECORDING_DETECTION_SAMPLE_EVERY_N_FRAMES="1"
export MINIO_ENDPOINT="127.0.0.1:9000"
export MINIO_USE_SSL="false"
export MINIO_RECORDING_BUCKET="p4-trip-recordings"
export MINIO_ACCESS_KEY="p4-relay"
export MINIO_SECRET_KEY="replace-relay-secret"
export MINIO_NODE_ACCESS_KEY="p4-node"
export MINIO_NODE_SECRET_KEY="replace-node-secret"
export MINIO_PUBLIC_ENDPOINT="https://${TLS_PUBLIC_ADDRESS}:39003"
export MINIO_BROWSER_REDIRECT_URL="https://${TLS_PUBLIC_ADDRESS}:39004"
export MINIO_ROOT_USER="p4-minio-root"
export MINIO_ROOT_PASSWORD="replace-minio-root-password"

# Android GPS/IMU telemetry (telemetry-events DataChannel). Independent of
# recording: when true, the relay validates the stream identity through Node
# and needs NODE_INTERNAL_BASE_URL/NODE_INTERNAL_SERVICE_TOKEN above even with
# RECORDING_ENABLED=false. Set the same value for the relay and Node. Replace
# the example service token before enabling.
export ANDROID_TELEMETRY_ENABLED="false"
# Relay -> Vision live-video telemetry timeline.
export PY_TELEMETRY_URL="http://${HOST}:${VISION_PORT}/internal/telemetry"
# Routing/tracking reads current device positions from the relay.
export MEDIA_RELAY_INTERNAL_BASE_URL="http://${RELAY_LISTEN_ADDR}"
# Operator origins allowed to receive presented-frame telemetry from the Vision
# live-view iframe (comma-separated). Empty allows only a same-hostname parent.
export LIVE_VIEW_PARENT_ORIGINS="${PUBLIC_OPERATOR_URL}"

# Maximum time for each service health check during one-command startup.
export HEALTH_TIMEOUT_SECONDS="300"
