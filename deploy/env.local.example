# Copy this file to deploy/env.local, edit the values, then source it from
# every service shell. Do not commit deploy/env.local.
#
#   cp deploy/env.local.example deploy/env.local
#   $EDITOR deploy/env.local
#   set -a; source deploy/env.local; set +a

# Absolute checkout path on the Linux host.
export P4_ROOT="/home/user/p4_integrated_backend"

# Node runtime. The stack script discovers ~/.nvm/nvm.sh when Node is not on
# PATH, then selects or installs this version. Set NVM_DIR only for a custom
# nvm installation location.
export NODE_VERSION="lts/*"
# export NVM_DIR="/custom/path/to/.nvm"

# Common bind address and service ports.
export HOST="127.0.0.1"
export NODE_PORT="3000"
export ROUTING_PORT="8000"
export VISION_PORT="39011"
export RELAY_LISTEN_ADDR="127.0.0.1:39012"

# PostgreSQL/PostGIS and Node control API.
export DATABASE_URL="postgresql://app:app@127.0.0.1:5432/vehicle_platform?schema=public"
export NODE_ENV="production"
export JWT_PRIVATE_KEY_PATH="${P4_ROOT}/secrets/jwt/private.pem"
export JWT_PUBLIC_KEY_PATH="${P4_ROOT}/secrets/jwt/public.pem"
export JWT_ISSUER="project4-node"
export JWT_AUDIENCE="project4-api"
export JWT_ACCESS_TOKEN_TTL="15m"
export JWT_KEY_ID="project4-2026-01"

# Browser-visible URLs. Change the address together with the certificate SAN.
export TLS_PUBLIC_ADDRESS="10.174.96.95"
export PUBLIC_OPERATOR_URL="https://10.174.96.95:39001"
export VISION_PUBLIC_BASE_URL="https://10.174.96.95:39002"
export LIVE_VIEW_URL="https://10.174.96.95:39002/"
export ROUTING_TRACKING_BASE_URL="http://${HOST}:${ROUTING_PORT}"
export TRUST_PROXY="true"

# Temporary read-only dashboard access. Set false before exposing beyond a
# trusted development LAN; normal JWT/RBAC routes remain enabled.
export OPERATOR_DEMO_PUBLIC="true"

# Route/tracking. Playback is deterministic and needs no BIMS key. Change to
# live and provide BUSAN_BIMS_SERVICE_KEY when live BIMS polling is desired.
export TELEMETRY_MODE="playback"
export BUSAN_BUS_HISTORY_PATH="${P4_ROOT}/services/routing-tracking/data/busan_bus_gps.csv"
export BUSAN_BUS_HYBRID_PATH="${P4_ROOT}/services/routing-tracking/data/busan_bus_hybrid.csv"
# export TELEMETRY_MODE="live"
# export BUSAN_BIMS_SERVICE_KEY="replace-with-data-go-kr-key"

# Vision Python/WebRTC/segmentation service. The RTX 3090 should use CUDA 0.
export SEGMENTATION_BACKEND="sam3"
export SAM3_CHECKPOINT_PATH="/workspace/models/sam3.pt"
export SAM3_BPE_PATH="/workspace/sam3/sam3/assets/bpe_simple_vocab_16e6.txt.gz"
export SAM3_PROMPT="person"
export SAM3_DEVICE="cuda:0"
export SAM3_SCORE_THRESHOLD="0.5"
export YOLO_DEVICE="cuda:0"
export YOLO_HALF="true"
export YOLO_MODEL="yolo26s-seg.pt"
export TLS_ENABLED="false"
export FORWARDED_ALLOW_IPS="127.0.0.1"
export YOLO_FEED_SOCKET="/tmp/poc-relay-yolo.sock"
export RELAY_KEYFRAME_URL="http://${HOST}:39012/internal/request-keyframe"
export RELAY_STATUS_URL="http://${HOST}:39012/internal/status"

# Go relay and TURN. Use a strong TURN password in the real file. Set
# TURN_URL empty to disable TURN for a same-LAN smoke test.
export TURN_URL="turn:10.174.96.95:3478?transport=udp"
export TURN_USERNAME="user"
export TURN_PASSWORD="replace-with-strong-turn-password"
export PY_ANDROID_LIVE_URL="http://${HOST}:${VISION_PORT}/internal/android-live"

# Maximum time for each service health check during one-command startup.
export HEALTH_TIMEOUT_SECONDS="300"
