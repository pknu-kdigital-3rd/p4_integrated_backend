<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC101820"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IDLE"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="HTTPS relay URL, e.g. https://its.example.internal"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#B0FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recording IDs"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recordingContextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter both IDs to send recording context."
                android:textColor="#FFFFD54F"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trip ID"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/recordingTripId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter a positive trip ID"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#B0FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vehicle ID"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/recordingVehicleId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter a positive vehicle ID"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#B0FFFFFF" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#33FFFFFF"
                android:popupBackground="#FF101820" />

            <TextView
                android:id="@+id/actualResolutionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#B0FFFFFF"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/qrScanningSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="QR scanning"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/qrStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="QR: waiting for scan…"
                android:textColor="#FFFFFF00"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/telemetrySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="Telemetry simulation"
                android:textColor="#FFFFFFFF" />

            <Button
                android:id="@+id/selectDatasetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select dataset folder" />

            <TextView
                android:id="@+id/datasetSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No dataset selected"
                android:textColor="#B0FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/telemetryStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Telemetry: disabled"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/streamButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_streaming" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
